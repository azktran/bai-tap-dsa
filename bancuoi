@dataclass
class Route:
    shipper_id: int
    depot_idx: int
    stops: list[int]
    load_kg: float

    def full_path(self) -> list[int]:
        return [self.depot_idx] + self.stops + [self.depot_idx]


def route_travel_time(path: list[int], time_matrix: np.ndarray) -> float:
    if len(path) < 2:
        return 0.0
    travel = sum(float(time_matrix[path[i], path[i + 1]]) for i in range(len(path) - 1))
    service = max(0, len(path) - 2) * SERVICE_TIME_MIN
    return travel + service


def nearest_neighbor_route(
    depot_idx: int,
    candidates: list[int],
    order_weights: dict[int, float],
    time_matrix: np.ndarray,
) -> tuple[list[int], list[int], float]:
    remaining = set(candidates)
    route = []
    load = 0.0
    current = depot_idx

    while remaining:
        feasible = [
            stop for stop in remaining
            if load + order_weights[stop] <= SHIPPER_CAPACITY_KG
        ]
        if not feasible:
            break

        best = min(feasible, key=lambda stop: float(time_matrix[current, stop]))
        trial_path = [depot_idx] + route + [best] + [depot_idx]
        if route_travel_time(trial_path, time_matrix) > SHIPPER_MAX_TIME_MIN:
            break

        route.append(best)
        remaining.remove(best)
        load += order_weights[best]
        current = best

    return route, sorted(remaining), load


def two_opt(stops: list[int], depot_idx: int, time_matrix: np.ndarray) -> list[int]:
    if len(stops) < 4:
        return stops

    best = stops[:]
    best_cost = route_travel_time([depot_idx] + best + [depot_idx], time_matrix)
    improved = True

    while improved:
        improved = False
        for i in range(len(best) - 1):
            for j in range(i + 2, len(best)):
                candidate = best[:i] + best[i:j + 1][::-1] + best[j + 1:]
                cost = route_travel_time([depot_idx] + candidate + [depot_idx], time_matrix)
                if cost + 1e-6 < best_cost:
                    best = candidate
                    best_cost = cost
                    improved = True
                    break
            if improved:
                break
    return best


def route_time_from_stops(depot_idx: int, stops: list[int], time_matrix: np.ndarray) -> float:
    return route_travel_time([depot_idx] + stops + [depot_idx], time_matrix)


def route_times(routes: list[Route], time_matrix: np.ndarray) -> list[float]:
    return [route_time_from_stops(route.depot_idx, route.stops, time_matrix) for route in routes]


def workload_stats(times: list[float]) -> dict[str, float]:
    if not times:
        return {
            "min_time_min": 0.0,
            "max_time_min": 0.0,
            "mean_time_min": 0.0,
            "std_time_min": 0.0,
            "range_time_min": 0.0,
        }
    return {
        "min_time_min": round(float(np.min(times)), 2),
        "max_time_min": round(float(np.max(times)), 2),
        "mean_time_min": round(float(np.mean(times)), 2),
        "std_time_min": round(float(np.std(times)), 2),
        "range_time_min": round(float(np.max(times) - np.min(times)), 2),
    }


def workload_balance_objective(times: list[float]) -> float:
    """
    Penalize uneven shipper workloads.

    The objective gives the highest priority to reducing the longest route,
    then reducing the max-min range and standard deviation. A tiny total-time
    term prevents moves that balance by making every route unnecessarily worse.
    """
    if not times:
        return 0.0
    max_time = float(np.max(times))
    time_range = float(np.max(times) - np.min(times))
    std_time = float(np.std(times))
    total_time = float(np.sum(times))
    return max_time + 0.45 * time_range + 0.25 * std_time + 0.01 * total_time


def balance_routes_by_workload(
    routes: list[Route],
    order_weights: dict[int, float],
    time_matrix: np.ndarray,
    max_iter: int = 80,
) -> dict[str, Any]:
    """
    Improve fairness between shippers with cross-route relocate/swap moves.

    This is a local-search balancing phase after the normal VRP construction.
    It keeps the same assigned orders, but tries to redistribute stops between
    routes so route durations are less uneven.
    """
    before_times = route_times(routes, time_matrix)
    before_stats = workload_stats(before_times)
    moves_applied: list[dict[str, Any]] = []

    for _ in range(max_iter):
        current_times = route_times(routes, time_matrix)
        current_obj = workload_balance_objective(current_times)
        best_move = None
        best_obj = current_obj

        # Relocate one order from one route to another.
        for src_idx, src_route in enumerate(routes):
            if len(src_route.stops) <= 1:
                continue
            for stop_pos, stop in enumerate(src_route.stops):
                stop_weight = order_weights[stop]
                src_without = src_route.stops[:stop_pos] + src_route.stops[stop_pos + 1 :]

                for dst_idx, dst_route in enumerate(routes):
                    if src_idx == dst_idx:
                        continue
                    if dst_route.load_kg + stop_weight > SHIPPER_CAPACITY_KG:
                        continue

                    for insert_pos in range(len(dst_route.stops) + 1):
                        dst_with = (
                            dst_route.stops[:insert_pos]
                            + [stop]
                            + dst_route.stops[insert_pos:]
                        )
                        src_candidate = src_without
                        dst_candidate = dst_with

                        src_time = route_time_from_stops(src_route.depot_idx, src_candidate, time_matrix)
                        dst_time = route_time_from_stops(dst_route.depot_idx, dst_candidate, time_matrix)
                        if src_time > SHIPPER_MAX_TIME_MIN or dst_time > SHIPPER_MAX_TIME_MIN:
                            continue

                        candidate_times = current_times[:]
                        candidate_times[src_idx] = src_time
                        candidate_times[dst_idx] = dst_time
                        candidate_obj = workload_balance_objective(candidate_times)
                        if candidate_obj + 1e-9 < best_obj:
                            best_obj = candidate_obj
                            best_move = {
                                "type": "relocate",
                                "src_idx": src_idx,
                                "dst_idx": dst_idx,
                                "stop": stop,
                                "src_stops": src_candidate,
                                "dst_stops": dst_candidate,
                                "src_load": src_route.load_kg - stop_weight,
                                "dst_load": dst_route.load_kg + stop_weight,
                                "before_range": round(max(current_times) - min(current_times), 2),
                                "after_range": round(max(candidate_times) - min(candidate_times), 2),
                            }

        # Swap one order between two routes.
        for a_idx in range(len(routes)):
            for b_idx in range(a_idx + 1, len(routes)):
                route_a = routes[a_idx]
                route_b = routes[b_idx]
                for pos_a, stop_a in enumerate(route_a.stops):
                    for pos_b, stop_b in enumerate(route_b.stops):
                        weight_a = order_weights[stop_a]
                        weight_b = order_weights[stop_b]
                        load_a = route_a.load_kg - weight_a + weight_b
                        load_b = route_b.load_kg - weight_b + weight_a
                        if load_a > SHIPPER_CAPACITY_KG or load_b > SHIPPER_CAPACITY_KG:
                            continue

                        stops_a = route_a.stops[:]
                        stops_b = route_b.stops[:]
                        stops_a[pos_a] = stop_b
                        stops_b[pos_b] = stop_a
                        cand_a = stops_a
                        cand_b = stops_b
                        time_a = route_time_from_stops(route_a.depot_idx, cand_a, time_matrix)
                        time_b = route_time_from_stops(route_b.depot_idx, cand_b, time_matrix)
                        if time_a > SHIPPER_MAX_TIME_MIN or time_b > SHIPPER_MAX_TIME_MIN:
                            continue

                        candidate_times = current_times[:]
                        candidate_times[a_idx] = time_a
                        candidate_times[b_idx] = time_b
                        candidate_obj = workload_balance_objective(candidate_times)
                        if candidate_obj + 1e-9 < best_obj:
                            best_obj = candidate_obj
                            best_move = {
                                "type": "swap",
                                "src_idx": a_idx,
                                "dst_idx": b_idx,
                                "stop_a": stop_a,
                                "stop_b": stop_b,
                                "src_stops": cand_a,
                                "dst_stops": cand_b,
                                "src_load": load_a,
                                "dst_load": load_b,
                                "before_range": round(max(current_times) - min(current_times), 2),
                                "after_range": round(max(candidate_times) - min(candidate_times), 2),
                            }

        if best_move is None:
            break

        src_route = routes[best_move["src_idx"]]
        dst_route = routes[best_move["dst_idx"]]
        src_route.stops = two_opt(best_move["src_stops"], src_route.depot_idx, time_matrix)
        dst_route.stops = two_opt(best_move["dst_stops"], dst_route.depot_idx, time_matrix)
        src_route.load_kg = round(float(best_move["src_load"]), 4)
        dst_route.load_kg = round(float(best_move["dst_load"]), 4)
        moves_applied.append(
            {
                key: value
                for key, value in best_move.items()
                if key not in {"src_stops", "dst_stops"}
            }
        )

    after_times = route_times(routes, time_matrix)
    after_stats = workload_stats(after_times)
    return {
        "algorithm": "cross_route_workload_balancing",
        "objective": "reduce max route time, time range, and standard deviation",
        "moves_applied": len(moves_applied),
        "before": before_stats,
        "after": after_stats,
        "move_log": moves_applied[:50],
    }


def part4_vrp_optimization(G: nx.MultiDiGraph | None = None) -> dict[str, Any]:
    print("\n" + "=" * 70)
    print("PART 4 â€” VRP OPTIMIZATION")
    print("=" * 70)

    delivery_data = load_json(OUTPUT_DIR / "delivery_nodes.json")
    zone_data = load_json(OUTPUT_DIR / "zone_assignments.json")
    time_matrix = np.load(OUTPUT_DIR / "time_matrix.npy")
    dist_matrix = np.load(OUTPUT_DIR / "dist_matrix.npy")

    deliveries = delivery_data["deliveries"]
    depots = delivery_data["depots"]

    order_weights = {
        order_idx_to_matrix_index(i): float(deliveries[i]["weight_kg"])
        for i in range(len(deliveries))
    }

    unassigned = set(order_idx_to_matrix_index(i) for i in range(len(deliveries)))
    routes: list[Route] = []

    for zone_id_str, zone in sorted(zone_data.items(), key=lambda item: int(item[0])):
        zone_id = int(zone_id_str)
        depot_name = zone["nearest_depot"]
        depot_idx = next(
            int(d["matrix_index"]) for d in depots if d["name"] == depot_name
        )
        candidates = [
            order_idx_to_matrix_index(i)
            for i in zone["delivery_indices"]
            if order_idx_to_matrix_index(i) in unassigned
        ]

        stops, leftover, load = nearest_neighbor_route(
            depot_idx,
            candidates,
            order_weights,
            time_matrix,
        )
        stops = two_opt(stops, depot_idx, time_matrix)
        for stop in stops:
            unassigned.discard(stop)

        routes.append(Route(zone_id, depot_idx, stops, load))

    # Try to insert unassigned orders into the cheapest feasible route.
    for stop in list(unassigned):
        weight = order_weights[stop]
        best_move = None
        for route_idx, route in enumerate(routes):
            if route.load_kg + weight > SHIPPER_CAPACITY_KG:
                continue
            for pos in range(len(route.stops) + 1):
                candidate_stops = route.stops[:pos] + [stop] + route.stops[pos:]
                candidate_path = [route.depot_idx] + candidate_stops + [route.depot_idx]
                candidate_time = route_travel_time(candidate_path, time_matrix)
                if candidate_time > SHIPPER_MAX_TIME_MIN:
                    continue
                old_time = route_travel_time(route.full_path(), time_matrix)
                delta = candidate_time - old_time
                if best_move is None or delta < best_move[0]:
                    best_move = (delta, route_idx, pos)
        if best_move:
            _, route_idx, pos = best_move
            routes[route_idx].stops.insert(pos, stop)
            routes[route_idx].load_kg += weight
            unassigned.discard(stop)

    balance_summary = balance_routes_by_workload(routes, order_weights, time_matrix)
    save_json(OUTPUT_DIR / "vrp_balance_summary.json", balance_summary)
    print(
        "Workload balance: "
        f"range {balance_summary['before']['range_time_min']:.1f} -> "
        f"{balance_summary['after']['range_time_min']:.1f} min | "
        f"std {balance_summary['before']['std_time_min']:.1f} -> "
        f"{balance_summary['after']['std_time_min']:.1f} min | "
        f"moves={balance_summary['moves_applied']}"
    )

    schedule = []
    for offset, route in enumerate(sorted(routes, key=lambda r: route_time_from_stops(r.depot_idx, r.stops, time_matrix), reverse=True)):
        path = route.full_path()
        travel_time = route_travel_time(path, time_matrix)
        travel_dist = sum(float(dist_matrix[path[i], path[i + 1]]) for i in range(len(path) - 1))
        schedule.append(
            {
                "shipper_id": route.shipper_id,
                "depot_idx": route.depot_idx,
                "depot_name": depots[route.depot_idx]["name"],
                "departure": f"{WORKING_START_HOUR:02d}:{offset * 5:02d}",
                "n_stops": len(route.stops),
                "load_kg": round(route.load_kg, 1),
                "total_time_min": round(travel_time, 1),
                "total_distance_km": round(travel_dist, 2),
                "feasible": route.load_kg <= SHIPPER_CAPACITY_KG and travel_time <= SHIPPER_MAX_TIME_MIN,
                "route_stops": path,
                "order_ids": [
                    deliveries[matrix_index_to_order_idx(stop)]["order_id"]
                    for stop in route.stops
                ],
            }
        )

    solution = {
        "metadata": {
            "algorithm": "Zone assignment + nearest neighbor + 2-opt + cheapest insertion",
            "n_depots": N_DEPOTS,
            "n_shippers": len(routes),
            "n_orders": len(deliveries),
            "assigned_orders": len(deliveries) - len(unassigned),
            "unassigned_orders": len(unassigned),
            "total_time_min": round(sum(s["total_time_min"] for s in schedule), 1),
            "total_distance_km": round(sum(s["total_distance_km"] for s in schedule), 2),
            "shipper_capacity_kg": SHIPPER_CAPACITY_KG,
            "shipper_max_time_min": SHIPPER_MAX_TIME_MIN,
            "workload_balance": balance_summary,
        },
        "schedule": schedule,
        "unassigned_orders": [
            {
                "order_index": matrix_index_to_order_idx(stop),
                "order_id": deliveries[matrix_index_to_order_idx(stop)]["order_id"],
            }
            for stop in sorted(unassigned)
        ],
    }
    save_json(OUTPUT_DIR / "vrp_solution.json", solution)
    if G is not None:
        visualize_part4_vrp_routes(G, solution, delivery_data)
    print(
        f"Assigned {solution['metadata']['assigned_orders']}/{len(deliveries)} orders | "
        f"unassigned={len(unassigned)}"
    )
    return solution


def matrix_route_to_graph_route(G: nx.MultiDiGraph, matrix_route: list[int]) -> list[Any]:
    """Convert a depot/order matrix route into a continuous graph-node route."""
    graph_route: list[str] = []
    for src_idx, dst_idx in zip(matrix_route[:-1], matrix_route[1:]):
        src = graph_node_from_matrix_index(src_idx)
        dst = graph_node_from_matrix_index(dst_idx)
        segment = shortest_node_route(G, src, dst)
        if not segment:
            continue
        if graph_route:
            segment = segment[1:]
        graph_route.extend(segment)
    return graph_route


