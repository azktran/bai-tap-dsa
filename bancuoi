def _visualize_it04_gantt(solution: dict[str, Any], events: list[dict[str, Any]]) -> None:
    INTEGRATION_TEST_DIR.mkdir(parents=True, exist_ok=True)
    event_by_shipper: dict[str, list[dict[str, Any]]] = defaultdict(list)
    for event in events:
        event_by_shipper[str(event.get("shipper_id"))].append(event)

    rows = []
    for route in solution.get("schedule", []):
        shipper_id = str(route.get("shipper_id"))
        shipper_events = event_by_shipper.get(shipper_id, [])
        if not shipper_events:
            continue
        start = min(float(event.get("time_min", 0.0)) for event in shipper_events)
        end = max(float(event.get("time_min", 0.0)) for event in shipper_events)
        rows.append((shipper_id, start, end))

    if not rows:
        return
    fig, ax = plt.subplots(figsize=(11, 5.5), dpi=170, facecolor="white")
    y_positions = np.arange(len(rows))
    for y, (shipper_id, start, end) in zip(y_positions, rows):
        ax.barh(y, end - start, left=start, color="#f59e0b", alpha=0.86)
        ax.text(end + 1, y, f"{end - start:.1f} min", va="center", fontsize=8)
    ax.set_yticks(y_positions)
    ax.set_yticklabels([f"S{row[0]}" for row in rows])
    ax.set_title("IT04 - Simulation Timeline by Shipper", fontsize=13, fontweight="bold", loc="left")
    ax.set_xlabel("Minutes from route departure baseline")
    ax.grid(axis="x", color="#e5e7eb")
    out_path = INTEGRATION_TEST_DIR / "it04_simulation_gantt.png"
    fig.savefig(out_path, bbox_inches="tight", facecolor=fig.get_facecolor())
    plt.close(fig)
    print(f"  Simulation Gantt chart: {out_path}")


