def integration_test_it04_vrp_to_simulation(solution: dict[str, Any], simulation_summary: dict[str, Any]) -> bool:
    print("\n" + "=" * 70)
    print("INTEGRATION TEST IT04 - VRP TO SIMULATION")
    print("=" * 70)

    events = load_json(OUTPUT_DIR / "simulation_events.json")
    planned_by_shipper = {
        str(route.get("shipper_id")): [str(order_id) for order_id in route.get("order_ids", [])]
        for route in solution.get("schedule", [])
    }
    simulated_by_shipper: dict[str, list[str]] = defaultdict(list)
    for event in events:
        if event.get("type") == "DELIVERED":
            simulated_by_shipper[str(event.get("shipper_id"))].append(str(event.get("order_id")))

    route_rows = []
    for shipper_id, planned_orders in planned_by_shipper.items():
        simulated_orders = simulated_by_shipper.get(shipper_id, [])
        route_rows.append(
            {
                "Shipper": shipper_id,
                "Planned Deliveries": len(planned_orders),
                "Simulated Deliveries": len(simulated_orders),
                "Missing Deliveries": len(set(planned_orders) - set(simulated_orders)),
                "Unexpected Deliveries": len(set(simulated_orders) - set(planned_orders)),
                "ROUTE_EXECUTED": set(planned_orders) == set(simulated_orders),
            }
        )

    planned_orders = _all_order_ids_from_solution(solution)
    simulated_orders = [str(event.get("order_id")) for event in events if event.get("type") == "DELIVERED"]
    missing_orders = set(planned_orders) - set(simulated_orders)
    unexpected_orders = set(simulated_orders) - set(planned_orders)
    route_count_vrp = len(solution.get("schedule", []))
    route_count_sim = len({str(event.get("shipper_id")) for event in events if event.get("type") == "DEPART"})
    delivered_event_count = len(simulated_orders)

    passed = (
        route_count_vrp == route_count_sim
        and len(planned_orders) == len(simulated_orders)
        and len(missing_orders) == 0
        and len(unexpected_orders) == 0
        and all(row["ROUTE_EXECUTED"] for row in route_rows)
    )

    summary_df = pd.DataFrame(
        [
            {
                "VRP Routes": route_count_vrp,
                "Simulation Routes": route_count_sim,
                "Planned Deliveries": len(planned_orders),
                "Simulated Deliveries": len(simulated_orders),
                "Missing Deliveries": len(missing_orders),
                "Delivered Events": delivered_event_count,
                "Simulation Summary Delivered": simulation_summary.get("delivered_orders", 0),
                "IT04_RESULT": "PASS" if passed else "FAIL",
            }
        ]
    )
    route_df = pd.DataFrame(route_rows)
    print(summary_df.to_string(index=False))
    print(route_df.to_string(index=False))
    _save_integration_table(summary_df, "IT04 - VRP to Simulation Summary", "it04_vrp_simulation_summary.png")
    _save_integration_table(route_df, "IT04 - Route Count and Delivery Reconciliation", "it04_route_reconciliation_table.png")
    _visualize_it04_delivery_comparison(route_df)
    _visualize_it04_gantt(solution, events)
    print(f"IT04 RESULT: {'PASS' if passed else 'FAIL'}")
    return passed


