class SegmentTree:
    """Segment tree for fast route-leg cost updates and range sums."""

    def __init__(self, values: list[float]) -> None:
        self.n = len(values)
        size = 1
        while size < max(1, self.n):
            size *= 2
        self.size = size
        self.tree = [0.0] * (2 * size)
        for idx, value in enumerate(values):
            self.tree[size + idx] = float(value)
        for idx in range(size - 1, 0, -1):
            self.tree[idx] = self.tree[idx * 2] + self.tree[idx * 2 + 1]

    def update(self, index: int, value: float) -> None:
        pos = self.size + index
        self.tree[pos] = float(value)
        pos //= 2
        while pos:
            self.tree[pos] = self.tree[pos * 2] + self.tree[pos * 2 + 1]
            pos //= 2

    def range_sum(self, left: int, right: int) -> float:
        left += self.size
        right += self.size
        total = 0.0
        while left < right:
            if left % 2:
                total += self.tree[left]
                left += 1
            if right % 2:
                right -= 1
                total += self.tree[right]
            left //= 2
            right //= 2
        return total


def matrix_to_coo(matrix: np.ndarray, finite_mask: np.ndarray) -> tuple[np.ndarray, np.ndarray, np.ndarray]:
    rows, cols = np.nonzero(finite_mask)
    values = matrix[rows, cols].astype(np.float32)
    return rows.astype(np.int32), cols.astype(np.int32), values


