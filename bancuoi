BASE32 = "0123456789bcdefghjkmnpqrstuvwxyz"


def encode_geohash(lat: float, lon: float, precision: int = 6) -> str:
    lat_range = [-90.0, 90.0]
    lon_range = [-180.0, 180.0]
    is_lon = True
    bits = []

    for _ in range(precision * 5):
        if is_lon:
            mid = sum(lon_range) / 2
            bit = lon >= mid
            lon_range[0 if bit else 1] = mid
        else:
            mid = sum(lat_range) / 2
            bit = lat >= mid
            lat_range[0 if bit else 1] = mid
        bits.append(1 if bit else 0)
        is_lon = not is_lon

    chars = []
    for i in range(0, len(bits), 5):
        value = 0
        for bit in bits[i : i + 5]:
            value = value * 2 + bit
        chars.append(BASE32[value])
    return "".join(chars)


def balanced_cluster_sizes(n_items: int, n_clusters: int) -> list[int]:
    base = n_items // n_clusters
    extra = n_items % n_clusters
    return [base + (1 if i < extra else 0) for i in range(n_clusters)]


def clean_order_time_matrix(time_matrix: np.ndarray) -> np.ndarray:
    """Return a finite, symmetric order-to-order cost matrix for k-medoids."""
    order_time = time_matrix[N_DEPOTS:, N_DEPOTS:].astype(float).copy()
    finite = order_time < UNREACHABLE
    fallback = float(np.nanmax(order_time[finite])) if finite.any() else 1.0
    order_time[~finite] = fallback * 3.0
    order_time = np.minimum(order_time, order_time.T)
    np.fill_diagonal(order_time, 0.0)
    return order_time


def initialize_medoids(cost_matrix: np.ndarray, k: int, seed: int) -> list[int]:
    """Deterministic farthest-first medoid initialization."""
    rng = random.Random(seed)
    n = cost_matrix.shape[0]
    medoids = [rng.randrange(n)]

    while len(medoids) < k:
        nearest_cost = np.min(cost_matrix[:, medoids], axis=1)
        nearest_cost[medoids] = -1.0
        next_medoid = int(np.argmax(nearest_cost))
        if next_medoid in medoids:
            remaining = [i for i in range(n) if i not in medoids]
            next_medoid = remaining[0]
        medoids.append(next_medoid)

    return medoids


def balanced_assign_to_medoids(
    cost_matrix: np.ndarray,
    medoids: list[int],
    target_sizes: list[int],
) -> dict[int, list[int]]:
    """
    Assign each order to one medoid while keeping cluster sizes balanced.

    Orders with a strong preference for one medoid are assigned first. This is a
    practical constrained assignment heuristic for small delivery batches.
    """
    k = len(medoids)
    clusters = {cluster_id: [] for cluster_id in range(k)}
    assigned: set[int] = set()

    preferences = []
    for order_idx in range(cost_matrix.shape[0]):
        ranked = sorted(
            range(k),
            key=lambda cluster_id: float(cost_matrix[order_idx, medoids[cluster_id]]),
        )
        best = float(cost_matrix[order_idx, medoids[ranked[0]]])
        second = float(cost_matrix[order_idx, medoids[ranked[1]]]) if k > 1 else best
        preferences.append((second - best, order_idx, ranked))

    preferences.sort(reverse=True)
    for _, order_idx, ranked_clusters in preferences:
        for cluster_id in ranked_clusters:
            if len(clusters[cluster_id]) < target_sizes[cluster_id]:
                clusters[cluster_id].append(order_idx)
                assigned.add(order_idx)
                break

    for order_idx in range(cost_matrix.shape[0]):
        if order_idx in assigned:
            continue
        cluster_id = min(
            range(k),
            key=lambda cid: (
                len(clusters[cid]) >= target_sizes[cid],
                float(cost_matrix[order_idx, medoids[cid]]),
            ),
        )
        clusters[cluster_id].append(order_idx)

    return clusters


def update_medoids(cost_matrix: np.ndarray, clusters: dict[int, list[int]]) -> list[int]:
    medoids = []
    for cluster_id in sorted(clusters):
        members = clusters[cluster_id]
        if not members:
            medoids.append(0)
            continue
        best_member = min(
            members,
            key=lambda candidate: float(cost_matrix[candidate, members].sum()),
        )
        medoids.append(int(best_member))
    return medoids


def balanced_k_medoids(
    cost_matrix: np.ndarray,
    k: int,
    seed: int = RANDOM_SEED,
    max_iter: int = 30,
) -> tuple[dict[int, list[int]], list[int], float]:
    """
    Balanced k-medoids over order-to-order travel-time costs.

    Returns clusters of order indices, medoid order indices, and total intra-zone
    travel-time cost.
    """
    if cost_matrix.shape[0] < k:
        raise ValueError("Number of orders must be >= number of clusters.")

    target_sizes = balanced_cluster_sizes(cost_matrix.shape[0], k)
    medoids = initialize_medoids(cost_matrix, k, seed)
    clusters = balanced_assign_to_medoids(cost_matrix, medoids, target_sizes)

    for _ in range(max_iter):
        new_medoids = update_medoids(cost_matrix, clusters)
        new_clusters = balanced_assign_to_medoids(cost_matrix, new_medoids, target_sizes)
        if new_medoids == medoids and new_clusters == clusters:
            break
        medoids = new_medoids
        clusters = new_clusters

    total_cost = 0.0
    for cluster_id, members in clusters.items():
        medoid = medoids[cluster_id]
        total_cost += float(cost_matrix[members, medoid].sum())

    return clusters, medoids, total_cost


