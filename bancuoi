def route_leg_costs(path: list[int], time_matrix: np.ndarray) -> list[float]:
    return [float(time_matrix[src, dst]) for src, dst in zip(path[:-1], path[1:])]


def evaluate_segment_tree_upgrade(solution: dict[str, Any]) -> dict[str, Any]:
    print("\n[DSA 6/8] Python list recompute vs Segment Tree benchmark...")
    time_matrix = np.load(OUTPUT_DIR / "time_matrix.npy")
    routes = [route for route in solution["schedule"] if len(route["route_stops"]) >= 3]
    if not routes:
        metrics = {"upgrade": "Python List -> Segment Tree", "part": "Part 4", "note": "No route with enough stops."}
        save_dsa_json("06_segment_tree_metrics.json", metrics)
        return metrics

    route = max(routes, key=lambda item: len(item["route_stops"]))
    leg_costs = route_leg_costs(route["route_stops"], time_matrix)
    rng = random.Random(RANDOM_SEED)
    updates = [
        (rng.randrange(len(leg_costs)), rng.uniform(0.5, max(max(leg_costs), 1.0) * 1.5))
        for _ in range(DSA_SEGMENT_TREE_OPS)
    ]

    list_costs = leg_costs[:]
    start = time.perf_counter()
    list_checksum = 0.0
    for index, new_value in updates:
        list_costs[index] = new_value
        list_checksum += sum(list_costs)
    list_time = time.perf_counter() - start

    tree = SegmentTree(leg_costs)
    start = time.perf_counter()
    tree_checksum = 0.0
    current = leg_costs[:]
    for index, new_value in updates:
        current[index] = new_value
        tree.update(index, current[index])
        tree_checksum += tree.range_sum(0, len(current))
    tree_time = time.perf_counter() - start

    metrics = {
        "upgrade": "Python List route cost recompute -> Segment Tree",
        "part": "Part 4",
        "route_shipper_id": route["shipper_id"],
        "route_leg_count": len(leg_costs),
        "benchmark_operations": len(updates),
        "list_recompute_time_sec": round(list_time, 6),
        "segment_tree_update_query_time_sec": round(tree_time, 6),
        "speedup_x": round(list_time / max(tree_time, 1e-9), 2),
        "checksum_match": abs(list_checksum - tree_checksum) <= 1e-6,
        "note": "This benchmarks repeated route-cost updates; actual Python list insertion still shifts elements.",
    }
    save_dsa_json("06_segment_tree_metrics.json", metrics)
    save_dsa_csv("06_segment_tree_metrics.csv", [metrics])
    print(f"  Segment tree speedup: {metrics['speedup_x']}x")
    return metrics


def route_distance_for_stops(depot_idx: int, stops: list[int], matrix: np.ndarray) -> float:
    return route_travel_time([depot_idx] + stops + [depot_idx], matrix)


def tabu_search_route(
    depot_idx: int,
    initial_stops: list[int],
    time_matrix: np.ndarray,
    iterations: int = DSA_TABU_ITERATIONS,
    tabu_tenure: int = 12,
) -> tuple[list[int], float, list[dict[str, Any]]]:
    if len(initial_stops) < 4:
        cost = route_distance_for_stops(depot_idx, initial_stops, time_matrix)
        return initial_stops[:], cost, []

    current = initial_stops[:]
    best = current[:]
    current_cost = route_distance_for_stops(depot_idx, current, time_matrix)
    best_cost = current_cost
    tabu: dict[tuple[int, int], int] = {}
    history = []

    for iteration in range(iterations):
        candidate = None
        candidate_move = None
        candidate_cost = float("inf")

        for i in range(len(current) - 1):
            for j in range(i + 1, len(current)):
                move = (min(current[i], current[j]), max(current[i], current[j]))
                trial = current[:]
                trial[i], trial[j] = trial[j], trial[i]
                cost = route_distance_for_stops(depot_idx, trial, time_matrix)
                aspiration = cost < best_cost
                if tabu.get(move, -1) > iteration and not aspiration:
                    continue
                if cost < candidate_cost:
                    candidate = trial
                    candidate_move = move
                    candidate_cost = cost

        if candidate is None or candidate_move is None:
            break

        current = candidate
        current_cost = candidate_cost
        tabu[candidate_move] = iteration + tabu_tenure
        if current_cost < best_cost:
            best = current[:]
            best_cost = current_cost

        history.append(
            {
                "iteration": iteration,
                "current_cost_min": round(float(current_cost), 4),
                "best_cost_min": round(float(best_cost), 4),
            }
        )

    return best, best_cost, history


def evaluate_tabu_upgrade(solution: dict[str, Any]) -> dict[str, Any]:
    print("\n[DSA 7/8] Greedy/2-opt vs Tabu Search benchmark...")
    time_matrix = np.load(OUTPUT_DIR / "time_matrix.npy")
    routes = [route for route in solution["schedule"] if len(route["route_stops"]) >= 6]
    if not routes:
