def build_routing_graph() -> nx.MultiDiGraph:
    """
    Download and prepare a practical logistics routing graph.

    simplify=True is intentional: OSMnx preserves road geometry on simplified
    edges, but the graph has far fewer routing states than simplify=False.
    """
    print("\n[1/5] Downloading routing graph...")
    print(f"      Place: {PLACE}")
    print("      network_type=all, simplify=True, retain_all=False")

    start = time.time()
    G = ox.graph_from_place(
        PLACE,
        network_type="all",
        simplify=True,
        retain_all=False,
        truncate_by_edge=True,
    )

    raw_nodes = G.number_of_nodes()
    raw_edges = G.number_of_edges()

    # ==========================
# UT01 - BEFORE STATISTICS
# ==========================

    before_counts = count_highway_types(G)

    blocked_counter = Counter()

    for _, _, _, data in G.edges(keys=True, data=True):
        if is_blocked_for_logistics(data):
            highway = normalize_highway(data.get("highway"))
            blocked_counter[highway] += 1

    blocked_edges = [
        (u, v, k)
        for u, v, k, data in G.edges(keys=True, data=True)
        if is_blocked_for_logistics(data)
    ]
    G.remove_edges_from(blocked_edges)
    G.remove_nodes_from(list(nx.isolates(G)))
    G = keep_largest_component(G)
    
    # ==========================
# UT01 - AFTER STATISTICS
# ==========================

    after_counts = count_highway_types(G)

    remaining_blocked = 0

    for _, _, _, data in G.edges(keys=True, data=True):
        if is_blocked_for_logistics(data):
            remaining_blocked += 1
    
    print("\n" + "="*70)
    print("UNIT TEST UT01 - HIGHWAY FILTERING")
    print("="*70)

    print("\nREMOVED ROAD TYPES:")

    for road_type, count in sorted(
        blocked_counter.items(),
        key=lambda x: x[1],
        reverse=True):
        print(f"  {road_type:20s}: {count:6,}")

    print("\nAFTER FILTERING:")

    for road_type in [
        "footway",
        "cycleway",
        "pedestrian",
        "steps"
]:
        print(
        f"  {road_type:20s}: "
        f"{after_counts.get(road_type,0):6,}"
    )

    print()

    if remaining_blocked == 0:
        print("UT01 RESULT: PASS")
    else:
        print("UT01 RESULT: FAIL")

    print(f"Remaining blocked edges: {remaining_blocked}")

    print("\nUT01 VALIDATION TABLE")

    print(
        f"{'ROAD TYPE':20s}"
