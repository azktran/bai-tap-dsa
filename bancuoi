def integration_test_it01_graph_to_time_matrix(G: nx.MultiDiGraph, delivery_data: dict[str, Any]) -> bool:
    print("\n" + "=" * 70)
    print("INTEGRATION TEST IT01 - GRAPH TO TIME MATRIX")
    print("=" * 70)

    time_matrix = np.load(OUTPUT_DIR / "time_matrix.npy")
    expected_size = len(delivery_data.get("depots", [])) + len(delivery_data.get("deliveries", []))
    finite = np.isfinite(time_matrix)
    nan_count = int(np.isnan(time_matrix).sum())
    negative_count = int((time_matrix[finite] < 0).sum())
    unreachable_count = int(((time_matrix >= UNREACHABLE) & finite).sum())
    required_attrs = ["weight_time", "weight_distance", "weight_logistics", "capacity"]
    missing_attr_edges = sum(
        1
        for _, _, _, data in G.edges(keys=True, data=True)
        if any(attr not in data for attr in required_attrs)
    )

    size_ok = tuple(time_matrix.shape) == (expected_size, expected_size)
    connected_ok = unreachable_count == 0
    passed = size_ok and nan_count == 0 and negative_count == 0 and missing_attr_edges == 0 and connected_ok

    df = pd.DataFrame(
        [
            {
                "Graph Nodes": G.number_of_nodes(),
                "Graph Edges": G.number_of_edges(),
                "Expected Matrix Size": f"{expected_size}x{expected_size}",
                "Actual Matrix Size": f"{time_matrix.shape[0]}x{time_matrix.shape[1]}",
                "NaN Values": nan_count,
                "Negative Values": negative_count,
                "Unreachable Values": unreachable_count,
                "Missing Weighted Edges": missing_attr_edges,
                "CONNECTED_OK": connected_ok,
                "IT01_RESULT": "PASS" if passed else "FAIL",
            }
        ]
    )
    print(df.to_string(index=False))
    _save_integration_table(df, "IT01 - Graph to Time Matrix Statistics", "it01_graph_time_matrix_table.png")
    _visualize_it01_time_matrix(time_matrix)
    print(f"IT01 RESULT: {'PASS' if passed else 'FAIL'}")
    return passed


