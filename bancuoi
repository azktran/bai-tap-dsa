def _apply_system_congestion(G: nx.MultiDiGraph, multiplier: float) -> nx.MultiDiGraph:
    scenario_graph = G.copy()
    if abs(multiplier - 1.0) < 1e-9:
        return scenario_graph

    for _, _, _, data in scenario_graph.edges(keys=True, data=True):
        base_time = to_float(data.get("weight_time"), 0.0)
        distance_km = to_float(data.get("weight_distance"), 0.0)
        congestion = to_float(data.get("congestion_factor"), 1.0) * multiplier
        data["congestion_factor"] = congestion
        data["weight_time"] = base_time * multiplier
        data["travel_time"] = to_float(data.get("travel_time"), 0.0) * multiplier
        data["weight_congestion"] = data["weight_time"] * congestion
        data["weight_logistics"] = data["weight_time"] * 500.0 * congestion + distance_km * 2000.0
    return scenario_graph


def _node_distance_from_centroid(G: nx.MultiDiGraph, node: Any, center_lat: float, center_lon: float) -> float:
    lat = float(G.nodes[node]["y"])
    lon = float(G.nodes[node]["x"])
    return (lat - center_lat) ** 2 + (lon - center_lon) ** 2


def _build_system_dataset_nodes(
    G: nx.MultiDiGraph,
    scenario: dict[str, Any],
    seed_offset: int,
) -> tuple[list[Any], list[Any], list[Any]]:
    rng = random.Random(RANDOM_SEED + seed_offset)
    nodes = list(G.nodes())
    if len(nodes) < N_DEPOTS + N_DELIVERIES:
        raise ValueError("Graph has fewer nodes than requested system-test depots + deliveries.")

    center_lat = float(np.mean([float(G.nodes[node]["y"]) for node in nodes]))
    center_lon = float(np.mean([float(G.nodes[node]["x"]) for node in nodes]))
    central_nodes = sorted(nodes, key=lambda node: _node_distance_from_centroid(G, node, center_lat, center_lon))

    if scenario["order_strategy"] == "far_from_depots":
        depots = central_nodes[:N_DEPOTS]
        depot_lat = float(np.mean([float(G.nodes[node]["y"]) for node in depots]))
        depot_lon = float(np.mean([float(G.nodes[node]["x"]) for node in depots]))
        candidates = [node for node in nodes if node not in set(depots)]
        far_nodes = sorted(candidates, key=lambda node: _node_distance_from_centroid(G, node, depot_lat, depot_lon), reverse=True)
        deliveries = far_nodes[:N_DELIVERIES]
    else:
        sampled = rng.sample(nodes, N_DEPOTS + N_DELIVERIES)
        depots = sampled[:N_DEPOTS]
        deliveries = sampled[N_DEPOTS:]

    return depots, deliveries, depots + deliveries


def _build_system_metadata(
    G: nx.MultiDiGraph,
    depots: list[Any],
    deliveries: list[Any],
    scenario: dict[str, Any],
    seed_offset: int,
) -> dict[str, Any]:
    rng = random.Random(RANDOM_SEED + seed_offset)
    delivery_rows = []
    for i, node in enumerate(deliveries):
        if scenario["weight_strategy"] == "heavy":
            weight = round(rng.uniform(7.0, 8.0), 1)
        else:
            weight = round(rng.uniform(0.5, 8.0), 1)
        delivery_rows.append(
            {
                "node_id": str(node),
                "matrix_index": order_idx_to_matrix_index(i),
                "order_index": i,
                "order_id": f"{scenario['id'].upper()}-ORD-{1000 + i}",
                "lat": float(G.nodes[node]["y"]),
                "lon": float(G.nodes[node]["x"]),
                "weight_kg": weight,
                "time_window": [
                    f"{rng.randint(8, 11):02d}:00",
                    f"{rng.randint(14, 18):02d}:00",
                ],
            }
        )

    return {
        "scenario": {
            "id": scenario["id"],
            "label": scenario["label"],
            "description": scenario["description"],
            "congestion_multiplier": scenario["congestion_multiplier"],
            "weight_strategy": scenario["weight_strategy"],
            "order_strategy": scenario["order_strategy"],
        },
        "depots": [
            {
                "node_id": str(node),
                "matrix_index": i,
                "lat": float(G.nodes[node]["y"]),
                "lon": float(G.nodes[node]["x"]),
                "name": f"{scenario['label']} Depot {i + 1}",
            }
            for i, node in enumerate(depots)
        ],
        "deliveries": delivery_rows,
    }


def _prepare_system_part2_outputs(G: nx.MultiDiGraph, scenario: dict[str, Any], seed_offset: int) -> dict[str, Any]:
    depots, deliveries, all_points = _build_system_dataset_nodes(G, scenario, seed_offset)
    metadata = _build_system_metadata(G, depots, deliveries, scenario, seed_offset)
    save_json(OUTPUT_DIR / "delivery_nodes.json", metadata)
    save_json(
        OUTPUT_DIR / "matrix_nodes.json",
        {"nodes": [str(node) for node in all_points], "n_depots": N_DEPOTS},
    )

    print(f"Generated system dataset {scenario['label']}: {N_DEPOTS} depots, {N_DELIVERIES} orders")
    time_matrix = build_matrix(G, all_points, "weight_time", f"{scenario['id']}_time_matrix")
    dist_matrix = build_matrix(G, all_points, "weight_distance", f"{scenario['id']}_dist_matrix")
    np.save(OUTPUT_DIR / "time_matrix.npy", time_matrix)
    np.save(OUTPUT_DIR / "dist_matrix.npy", dist_matrix)

    finite = np.isfinite(time_matrix) & (time_matrix < UNREACHABLE)
    positive = (time_matrix > 0) & finite
    summary = {
        "scenario": scenario["label"],
        "n_points": len(all_points),
        "reachable_pairs": int(finite.sum()),
        "total_pairs": int(time_matrix.size),
        "reachable_pct": round(float(finite.mean() * 100), 2),
        "mean_time_min": round(float(time_matrix[positive].mean()), 2) if positive.any() else 0.0,
    }
    save_json(OUTPUT_DIR / "part2_summary.json", summary)
    return metadata


def _system_order_kpis(
    delivery_data: dict[str, Any],
    solution: dict[str, Any],
    simulation_summary: dict[str, Any],
) -> dict[str, Any]:
    input_orders = [str(order["order_id"]) for order in delivery_data.get("deliveries", [])]
    planned_orders = _all_order_ids_from_solution(solution)
    planned_counts = Counter(planned_orders)
    duplicate_orders = sum(count - 1 for count in planned_counts.values() if count > 1)
    missing_orders = len(set(input_orders) - set(planned_orders))
    delivered_orders = int(simulation_summary.get("delivered_orders", 0))
    capacity_violations = sum(
        1
        for route in solution.get("schedule", [])
        if float(route.get("load_kg", 0.0)) > SHIPPER_CAPACITY_KG
    )
    time_violations = sum(
        1
        for route in solution.get("schedule", [])
        if float(route.get("total_time_min", 0.0)) > SHIPPER_MAX_TIME_MIN
    )
    total_demand = sum(float(order.get("weight_kg", 0.0)) for order in delivery_data.get("deliveries", []))

    return {
        "Total Orders": len(input_orders),
        "Delivered Orders": delivered_orders,
        "Missing Orders": int(missing_orders),
        "Duplicate Orders": int(duplicate_orders),
        "Routes Created": len(solution.get("schedule", [])),
        "Total Time Min": round(float(solution.get("metadata", {}).get("total_time_min", 0.0)), 2),
        "Total Distance KM": round(float(solution.get("metadata", {}).get("total_distance_km", 0.0)), 2),
        "Total Demand KG": round(total_demand, 2),
        "Fleet Capacity KG": round(SHIPPER_CAPACITY_KG * max(len(solution.get("schedule", [])), 1), 2),
        "Capacity Violations": int(capacity_violations),
        "Time Violations": int(time_violations),
    }


def _system_test_statuses(kpis: dict[str, Any]) -> dict[str, str]:
    st01 = (
        kpis["Delivered Orders"] == kpis["Total Orders"]
        and kpis["Missing Orders"] == 0
        and kpis["Duplicate Orders"] == 0
    )
    st02 = kpis["Time Violations"] == 0
    st03 = kpis["Capacity Violations"] == 0
    st04 = kpis["Routes Created"] > 0
    return {
        "ST01": "PASS" if st01 else "FAIL",
        "ST02": "PASS" if st02 else "FAIL",
        "ST03": "PASS" if st03 else "FAIL",
        "ST04": "PASS" if st04 else "FAIL",
    }


