def _route_total_weight(G: nx.MultiDiGraph, route: list[Any], weight: str) -> float:
    total = 0.0
    for u, v in zip(route[:-1], route[1:]):
        edge_data = G.get_edge_data(resolve_graph_node(G, u), resolve_graph_node(G, v))
        if not edge_data:
            raise nx.NetworkXNoPath(f"Missing edge {u}->{v} while tracing route")
        total += min(to_float(data.get(weight), 0.0) for data in edge_data.values())
    return total


def unit_test_ut04_dijkstra_shortest_path(
    G: nx.MultiDiGraph,
    pair_count: int = 10,
    seed: int = 44,
) -> bool:
    """
    UT04: verify shortest_path with weight_time returns traceable positive-cost routes.
    """

    print("\n" + "=" * 70)
    print("UNIT TEST UT04 - DIJKSTRA SHORTEST PATH")
    print("=" * 70)

    rng = random.Random(seed)
    nodes = list(G.nodes())
    pairs = []
    attempts = 0
    while len(pairs) < min(pair_count, max(len(nodes) // 2, 0)) and attempts < pair_count * 30:
        src, dst = rng.sample(nodes, 2)
        if src != dst:
            pairs.append((src, dst))
        attempts += 1

    rows = []
    route_examples = []
    for idx, (src, dst) in enumerate(pairs, start=1):
        found = False
        total_cost = 0.0
        edge_count = 0
        error = ""
        route = []
        try:
            route = nx.shortest_path(G, source=src, target=dst, weight="weight_time")
            total_cost = _route_total_weight(G, route, "weight_time")
            edge_count = max(len(route) - 1, 0)
            found = edge_count > 0 and total_cost > 0.0
            if found and len(route_examples) < 3:
                route_examples.append((idx, src, dst, route, total_cost))
        except (nx.NetworkXNoPath, nx.NodeNotFound, ValueError) as exc:
            error = type(exc).__name__

        rows.append(
            {
                "No": idx,
                "Source": src,
                "Target": dst,
                "FOUND": found,
                "Total Cost (min)": round(total_cost, 6),
                "Edge Count": edge_count,
                "Error": error,
            }
        )

    df = pd.DataFrame(rows)
    print(df.to_string(index=False))

    passed = bool(len(df) > 0 and df["FOUND"].all() and (df["Total Cost (min)"] > 0).all())
    print(f"\nUT04 RESULT: {'PASS' if passed else 'FAIL'}")
    _save_dataframe_table(df, "UT04 - Dijkstra Shortest Path Validation", "ut04_dijkstra_table.png")
    _visualize_ut04_shortest_paths(G, route_examples)
    return passed


