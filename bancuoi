    {"id": "normal", "label": "Normal", "weight_range": (0.5, 8.0)},
    {"id": "heavy", "label": "Heavy", "weight_range": (7.0, 8.0)},
    {"id": "extreme", "label": "Extreme", "weight_range": (10.0, 12.0)},
    {"id": "critical", "label": "Critical", "weight_range": (15.0, 20.0)},
]


def _stress_dir(*parts: str) -> Path:
    return STRESS_TEST_DIR.joinpath(*parts)


def _select_stress_nodes(
    G: nx.MultiDiGraph,
    order_count: int,
    seed: int,
) -> tuple[list[Any], list[Any], list[Any], int]:
    rng = random.Random(seed)
    nodes = list(G.nodes())
    if len(nodes) <= N_DEPOTS:
        raise ValueError("Graph does not have enough nodes for stress-test depots.")

    requested_total = N_DEPOTS + order_count
    actual_order_count = min(order_count, max(len(nodes) - N_DEPOTS, 0))
    if actual_order_count < order_count:
        print(
            f"  WARNING: requested {order_count} orders but graph has only "
            f"{actual_order_count} unique delivery nodes available."
        )

    sampled = rng.sample(nodes, min(requested_total, len(nodes)))
    depots = sampled[:N_DEPOTS]
    deliveries = sampled[N_DEPOTS:N_DEPOTS + actual_order_count]
    return depots, deliveries, depots + deliveries, actual_order_count


def _build_stress_metadata(
    G: nx.MultiDiGraph,
    depots: list[Any],
    deliveries: list[Any],
    label: str,
    weight_range: tuple[float, float],
    seed: int,
) -> dict[str, Any]:
    rng = random.Random(seed)
    low, high = weight_range
    return {
        "stress_dataset": {
            "label": label,
            "weight_range": [low, high],
            "order_count": len(deliveries),
        },
        "depots": [
            {
                "node_id": str(node),
                "matrix_index": i,
                "lat": float(G.nodes[node]["y"]),
                "lon": float(G.nodes[node]["x"]),
                "name": f"{label} Depot {i + 1}",
            }
            for i, node in enumerate(depots)
        ],
        "deliveries": [
            {
                "node_id": str(node),
                "matrix_index": order_idx_to_matrix_index(i),
                "order_index": i,
                "order_id": f"{label.upper().replace(' ', '-')}-ORD-{1000 + i}",
                "lat": float(G.nodes[node]["y"]),
                "lon": float(G.nodes[node]["x"]),
                "weight_kg": round(rng.uniform(low, high), 1),
                "time_window": [
                    f"{rng.randint(8, 11):02d}:00",
                    f"{rng.randint(14, 18):02d}:00",
                ],
            }
            for i, node in enumerate(deliveries)
        ],
    }


def _prepare_stress_part2_outputs(
    G: nx.MultiDiGraph,
    label: str,
    order_count: int,
    weight_range: tuple[float, float],
    seed: int,
) -> tuple[dict[str, Any], int]:
    depots, deliveries, all_points, actual_order_count = _select_stress_nodes(G, order_count, seed)
    metadata = _build_stress_metadata(G, depots, deliveries, label, weight_range, seed)
    save_json(OUTPUT_DIR / "delivery_nodes.json", metadata)
    save_json(
        OUTPUT_DIR / "matrix_nodes.json",
        {"nodes": [str(node) for node in all_points], "n_depots": N_DEPOTS},
    )

    print(f"Stress dataset {label}: requested={order_count}, actual={actual_order_count}")
    time_matrix = build_matrix(G, all_points, "weight_time", f"{label}_time_matrix")
    dist_matrix = build_matrix(G, all_points, "weight_distance", f"{label}_dist_matrix")
    np.save(OUTPUT_DIR / "time_matrix.npy", time_matrix)
    np.save(OUTPUT_DIR / "dist_matrix.npy", dist_matrix)

    finite = np.isfinite(time_matrix) & (time_matrix < UNREACHABLE)
    positive = (time_matrix > 0) & finite
    save_json(
        OUTPUT_DIR / "part2_summary.json",
        {
            "label": label,
            "requested_orders": order_count,
            "actual_orders": actual_order_count,
            "n_points": len(all_points),
            "reachable_pairs": int(finite.sum()),
            "total_pairs": int(time_matrix.size),
            "reachable_pct": round(float(finite.mean() * 100), 2),
            "mean_time_min": round(float(time_matrix[positive].mean()), 2) if positive.any() else 0.0,
        },
    )
    return metadata, actual_order_count


def _stress_kpis(
    requested_orders: int,
    actual_orders: int,
    delivery_data: dict[str, Any],
    solution: dict[str, Any],
    simulation_summary: dict[str, Any],
    runtime_s: float,
) -> dict[str, Any]:
    planned_orders = _all_order_ids_from_solution(solution)
    planned_counts = Counter(planned_orders)
    duplicate_orders = sum(count - 1 for count in planned_counts.values() if count > 1)
    delivered_orders = int(simulation_summary.get("delivered_orders", 0))
    missing_orders = max(requested_orders - delivered_orders, 0)
    total_demand = sum(float(order.get("weight_kg", 0.0)) for order in delivery_data.get("deliveries", []))
    route_count = len(solution.get("schedule", []))
    capacity_violations = sum(
        1
        for route in solution.get("schedule", [])
        if float(route.get("load_kg", 0.0)) > SHIPPER_CAPACITY_KG
    )
    time_violations = sum(
        1
        for route in solution.get("schedule", [])
        if float(route.get("total_time_min", 0.0)) > SHIPPER_MAX_TIME_MIN
    )
    assigned_orders = int(solution.get("metadata", {}).get("assigned_orders", len(planned_orders)))
    unassigned_orders = int(solution.get("metadata", {}).get("unassigned_orders", 0)) + max(requested_orders - actual_orders, 0)
    delivery_rate = delivered_orders / max(requested_orders, 1) * 100.0

    return {
        "Requested Orders": int(requested_orders),
        "Actual Orders": int(actual_orders),
        "Runtime": round(runtime_s, 2),
        "Orders Delivered": delivered_orders,
        "Missing Orders": int(missing_orders),
        "Duplicate Orders": int(duplicate_orders),
        "Route Count": route_count,
        "Delivery Rate": round(delivery_rate, 2),
        "Total Demand": round(total_demand, 2),
        "Fleet Capacity": round(SHIPPER_CAPACITY_KG * max(route_count, 1), 2),
        "Assigned Orders": assigned_orders,
        "Unassigned Orders": unassigned_orders,
        "Capacity Violations": int(capacity_violations),
        "Time Violations": int(time_violations),
        "Total Time Min": round(float(solution.get("metadata", {}).get("total_time_min", 0.0)), 2),
        "Total Distance KM": round(float(solution.get("metadata", {}).get("total_distance_km", 0.0)), 2),
    }


def _stress_result(kpis: dict[str, Any]) -> str:
    passed = (
        kpis["Orders Delivered"] == kpis["Requested Orders"]
        and kpis["Missing Orders"] == 0
        and kpis["Duplicate Orders"] == 0
        and kpis["Capacity Violations"] == 0
    )
    return "PASS" if passed else "FAIL"


def _run_stress_pipeline(
    base_graph: nx.MultiDiGraph,
    output_dir: Path,
    label: str,
    order_count: int,
    weight_range: tuple[float, float],
    seed: int,
) -> dict[str, Any]:
    output_dir.mkdir(parents=True, exist_ok=True)
    start = time.perf_counter()
    previous_output = _switch_output_dir(output_dir)
    try:
        delivery_data, actual_orders = _prepare_stress_part2_outputs(
            base_graph,
            label,
            order_count,
            weight_range,
            seed,
        )
        zone_summary = part3_zone_division(base_graph)
        solution = part4_vrp_optimization(base_graph)
        simulation_summary = part5_simulation_dashboard(base_graph)
        runtime_s = time.perf_counter() - start
        kpis = _stress_kpis(order_count, actual_orders, delivery_data, solution, simulation_summary, runtime_s)
        kpis["Result"] = _stress_result(kpis)
        kpis["Error"] = ""
    except Exception as exc:
        runtime_s = time.perf_counter() - start
        kpis = {
            "Requested Orders": int(order_count),
            "Actual Orders": 0,
            "Runtime": round(runtime_s, 2),
            "Orders Delivered": 0,
            "Missing Orders": int(order_count),
            "Duplicate Orders": 0,
            "Route Count": 0,
            "Delivery Rate": 0.0,
            "Total Demand": 0.0,
            "Fleet Capacity": 0.0,
            "Assigned Orders": 0,
            "Unassigned Orders": int(order_count),
            "Capacity Violations": 0,
            "Time Violations": 0,
            "Total Time Min": 0.0,
            "Total Distance KM": 0.0,
            "Result": "FAIL",
            "Error": f"{type(exc).__name__}: {exc}",
        }
        print(f"  STRESS LEVEL FAILED: {kpis['Error']}")
    finally:
        _switch_output_dir(previous_output)

    save_json(output_dir / "stress_kpi_summary.json", kpis)
    _save_system_table(pd.DataFrame([kpis]), f"Stress KPI - {label}", output_dir / "stress_kpi_summary.png")

    if kpis["Route Count"] > 0:
        previous_output = _switch_output_dir(output_dir)
        try:
            solution = load_json(output_dir / "vrp_solution.json")
            _visualize_system_routes(base_graph, solution, output_dir, f"Stress Route Map - {label}")
            _visualize_system_route_loads(solution, output_dir)
            _visualize_system_route_times(solution, output_dir)
        finally:
            _switch_output_dir(previous_output)
    return kpis


def _stress_metric_matrix(rows: list[dict[str, Any]], columns: list[str], metrics: list[str]) -> pd.DataFrame:
    matrix_rows = []
    row_by_label = {str(row["Label"]): row for row in rows}
    for metric in metrics:
        matrix_row = {"Metric": metric}
        for column in columns:
            matrix_row[column] = row_by_label[column].get(metric, "")
        matrix_rows.append(matrix_row)
    return pd.DataFrame(matrix_rows)


