def find_two_opt_demo(route: dict[str, Any], time_matrix: np.ndarray) -> tuple[list[int], list[int]]:
    depot_idx = int(route["depot_idx"])
    optimized = [idx for idx in route["route_stops"][1:-1] if idx >= N_DEPOTS]
    if len(optimized) < 4:
        return optimized, optimized

    shuffled = optimized[:]
    shuffled[1:4] = reversed(shuffled[1:4])
    improved = two_opt(shuffled, depot_idx, time_matrix)
    if improved == shuffled:
        shuffled = optimized[::-1]
        improved = two_opt(shuffled, depot_idx, time_matrix)
    return shuffled, improved


