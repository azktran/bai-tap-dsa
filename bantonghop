    const routeBounds = L.latLngBounds(data.segments.flatMap(segment => segment.path));
    if (routeBounds.isValid()) map.fitBounds(routeBounds.pad(0.18));

    const byShipper = new Map();
    const trails = new Map();
    data.segments.forEach(segment => {{
      if (!byShipper.has(segment.shipper_id)) byShipper.set(segment.shipper_id, []);
      byShipper.get(segment.shipper_id).push(segment);
      L.polyline(segment.path, {{
        color: data.colors[segment.shipper_id],
        weight: segment.type === 'SERVICE' ? 2 : 3,
        opacity: segment.type === 'SERVICE' ? 0.08 : 0.2,
        pane: 'routes',
        dashArray: segment.type === 'SERVICE' ? '3 6' : null
      }}).addTo(map);
    }});

    const markers = new Map();
    for (const [shipperId, segments] of byShipper.entries()) {{
      segments.sort((a, b) => a.start_min - b.start_min || a.sequence - b.sequence);
      const start = segments[0].path[0];
      const color = data.colors[shipperId];
      const marker = L.marker(start, {{
        icon: L.divIcon({{
          className: '',
          html: `<div class="shipper-icon" style="background:${{color}}">S${{shipperId}}</div>`,
          iconSize: [28, 28],
          iconAnchor: [14, 14]
        }})
      }}).addTo(map);
      marker.bindTooltip(`Shipper ${{shipperId}}`, {{ permanent: false }});
      markers.set(shipperId, marker);

      const color = data.colors[shipperId];
      const glow = L.polyline([], {{
        color,
        weight: 10,
        opacity: 0.35,
        pane: 'trails',
        lineCap: 'round',
        lineJoin: 'round'
      }}).addTo(map);
      const core = L.polyline([], {{
        color,
        weight: 4,
        opacity: 0.98,
        pane: 'trails',
        lineCap: 'round',
        lineJoin: 'round'
      }}).addTo(map);
      trails.set(shipperId, {{ glow, core }});
    }}

    const legend = document.getElementById('legend');
    legend.innerHTML = '<b>Shippers</b>' + Array.from(byShipper.keys()).sort((a,b)=>a-b).map(id =>
      `<div class="legend-row"><span class="swatch" style="background:${{data.colors[id]}}"></span>S${{id}}</div>`
    ).join('');

    function clockText(minutesFromStart) {{
      const total = data.workingStartHour * 60 + Math.round(minutesFromStart);
      const h = Math.floor(total / 60) % 24;
      const m = total % 60;
      return `${{String(h).padStart(2, '0')}}:${{String(m).padStart(2, '0')}}`;
    }}

    function interpolate(path, ratio) {{
      if (path.length === 1) return path[0];
      ratio = Math.max(0, Math.min(1, ratio));
      const distances = [];
      let total = 0;
      for (let i = 0; i < path.length - 1; i++) {{
        const a = path[i], b = path[i + 1];
        const d = Math.hypot(b[0] - a[0], b[1] - a[1]);
        distances.push(d);
        total += d;
      }}
      if (total === 0) return path[path.length - 1];
      let target = total * ratio;
      for (let i = 0; i < distances.length; i++) {{
        if (target <= distances[i]) {{
          const local = distances[i] === 0 ? 0 : target / distances[i];
          const a = path[i], b = path[i + 1];
          return [a[0] + (b[0] - a[0]) * local, a[1] + (b[1] - a[1]) * local];
        }}
        target -= distances[i];
      }}
      return path[path.length - 1];
    }}

    function pathPrefix(path, ratio) {{
      if (path.length <= 1) return path.slice();
      ratio = Math.max(0, Math.min(1, ratio));
      const distances = [];
      let total = 0;
      for (let i = 0; i < path.length - 1; i++) {{
        const a = path[i], b = path[i + 1];
        const d = Math.hypot(b[0] - a[0], b[1] - a[1]);
        distances.push(d);
        total += d;
      }}
      if (total === 0) return [path[0], path[path.length - 1]];

      let target = total * ratio;
      const result = [path[0]];
      for (let i = 0; i < distances.length; i++) {{
        const a = path[i], b = path[i + 1];
        if (target >= distances[i]) {{
          result.push(b);
          target -= distances[i];
          continue;
        }}
        const local = distances[i] === 0 ? 0 : target / distances[i];
        result.push([a[0] + (b[0] - a[0]) * local, a[1] + (b[1] - a[1]) * local]);
        break;
      }}
      return result;
    }}

    function travelledPath(segments, t) {{
      const points = [];
      for (const segment of segments) {{
        if (segment.type !== 'DRIVE') continue;
        if (t < segment.start_min) break;

        let addPath;
        if (t >= segment.end_min) {{
          addPath = segment.path;
        }} else {{
          const ratio = segment.end_min === segment.start_min
            ? 1
            : (t - segment.start_min) / (segment.end_min - segment.start_min);
          addPath = pathPrefix(segment.path, ratio);
        }}

        if (points.length && addPath.length) addPath = addPath.slice(1);
        points.push(...addPath);
        if (t < segment.end_min) break;
      }}
      return points;
    }}

    function update(t) {{
      current = Math.max(Number(data.minTime), Math.min(Number(data.maxTime), t));
      timeline.value = current;
      clock.textContent = clockText(current);
      activeLabels = {{}};

      for (const [shipperId, segments] of byShipper.entries()) {{
        let chosen = segments[0];
        for (const segment of segments) {{
          if (current >= segment.start_min && current <= segment.end_min) {{
            chosen = segment;
            break;
          }}
          if (current > segment.end_min) chosen = segment;
        }}

        const ratio = chosen.end_min === chosen.start_min
          ? 1
          : (current - chosen.start_min) / (chosen.end_min - chosen.start_min);
        const pos = interpolate(chosen.path, ratio);
        markers.get(shipperId).setLatLng(pos);
        const trail = travelledPath(segments, current);
        const trailLayers = trails.get(shipperId);
        trailLayers.glow.setLatLngs(trail);
        trailLayers.core.setLatLngs(trail);
        activeLabels[shipperId] = chosen.label;
      }}

      const labels = Object.entries(activeLabels)
        .map(([id, label]) => `S${{id}}: ${{label}}`)
        .slice(0, 4)
        .join(' | ');
      status.textContent = labels || 'Completed';
    }}

    function frame(ts) {{
      if (!playing) return;
      if (lastFrame === null) lastFrame = ts;
      const elapsedSeconds = (ts - lastFrame) / 1000;
      lastFrame = ts;
      update(current + elapsedSeconds * speedMinutesPerSecond);
      if (current >= Number(data.maxTime)) {{
        playing = false;
        playBtn.textContent = 'Play';
        lastFrame = null;
        return;
      }}
      requestAnimationFrame(frame);
    }}

    playBtn.addEventListener('click', () => {{
      playing = !playing;
      playBtn.textContent = playing ? 'Pause' : 'Play';
      lastFrame = null;
      if (playing) requestAnimationFrame(frame);
    }});

    resetBtn.addEventListener('click', () => {{
      playing = false;
      playBtn.textContent = 'Play';
      lastFrame = null;
      update(Number(data.minTime));
    }});

    timeline.addEventListener('input', () => {{
      playing = false;
      playBtn.textContent = 'Play';
      lastFrame = null;
      update(Number(timeline.value));
    }});

    update(Number(data.minTime));
  </script>
</body>
</html>
"""
    animation_path.write_text(html, encoding="utf-8")
    print(f"  Delivery animation HTML: {animation_path}")


def part5_simulation_dashboard(G: nx.MultiDiGraph | None = None) -> dict[str, Any]:
    print("\n" + "=" * 70)
    print("PART 5 — SIMULATION & DASHBOARD")
    print("=" * 70)

    solution = load_json(OUTPUT_DIR / "vrp_solution.json")
    delivery_data = load_json(OUTPUT_DIR / "delivery_nodes.json")
    time_matrix = np.load(OUTPUT_DIR / "time_matrix.npy")
    deliveries = delivery_data["deliveries"]

    events = []
    delivered = 0

    for route in solution["schedule"]:
        shipper_id = route["shipper_id"]
        path = route["route_stops"]
        current_time = parse_departure_minutes(route["departure"])

        events.append(
            {
                "time_min": round(current_time, 1),
                "clock": minutes_to_clock(current_time),
                "type": "DEPART",
                "shipper_id": shipper_id,
                "location": route["depot_name"],
            }
        )

        for i in range(len(path) - 1):
            src = path[i]
            dst = path[i + 1]
            travel = float(time_matrix[src, dst])
            current_time += travel

            if dst >= N_DEPOTS:
                order_idx = matrix_index_to_order_idx(dst)
                delivered += 1
                events.append(
                    {
                        "time_min": round(current_time, 1),
                        "clock": minutes_to_clock(current_time),
                        "type": "ARRIVE_ORDER",
                        "shipper_id": shipper_id,
                        "order_id": deliveries[order_idx]["order_id"],
                    }
                )
                current_time += SERVICE_TIME_MIN
                events.append(
                    {
                        "time_min": round(current_time, 1),
                        "clock": minutes_to_clock(current_time),
                        "type": "DELIVERED",
                        "shipper_id": shipper_id,
                        "order_id": deliveries[order_idx]["order_id"],
                    }
                )
            else:
                events.append(
                    {
                        "time_min": round(current_time, 1),
                        "clock": minutes_to_clock(current_time),
                        "type": "RETURN_DEPOT",
                        "shipper_id": shipper_id,
                        "location": route["depot_name"],
                    }
                )

    events.sort(key=lambda event: event["time_min"])
    summary = {
        "total_events": len(events),
        "delivered_orders": delivered,
        "unassigned_orders": len(solution["unassigned_orders"]),
        "total_time_min": solution["metadata"]["total_time_min"],
        "total_distance_km": solution["metadata"]["total_distance_km"],
        "active_shippers": len(solution["schedule"]),
    }

    save_json(OUTPUT_DIR / "simulation_events.json", events)
    save_json(OUTPUT_DIR / "simulation_summary.json", summary)
    save_delivery_animation_html(G, solution, delivery_data, time_matrix)
    save_dashboard_html(solution, summary, events)
    print(f"Saved simulation with {len(events)} events")
    return summary


def minutes_to_clock(minutes_from_start: float) -> str:
    total = WORKING_START_HOUR * 60 + int(round(minutes_from_start))
    return f"{(total // 60) % 24:02d}:{total % 60:02d}"


