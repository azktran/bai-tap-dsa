def visualize_cheapest_insertion_demo(
    G: nx.MultiDiGraph,
    delivery_data: dict[str, Any],
    solution: dict[str, Any],
) -> None:
    print("\n[SLIDES] 11 cheapest insertion demo...")
    route = select_demo_route(solution)
    if route is None or len(route["route_stops"]) < 5:
        return

    time_matrix = np.load(OUTPUT_DIR / "time_matrix.npy")
    full_route = route["route_stops"]
    base_route = full_route[:-2] + [full_route[-1]]
    inserted = full_route[-2]

    best_pos = None
    best_delta = float("inf")
    for pos in range(len(base_route) - 1):
        src = base_route[pos]
        dst = base_route[pos + 1]
        delta = float(time_matrix[src, inserted] + time_matrix[inserted, dst] - time_matrix[src, dst])
        if delta < best_delta:
            best_delta = delta
            best_pos = pos

    inserted_route = base_route[: best_pos + 1] + [inserted] + base_route[best_pos + 1 :]

    fig, ax = plt.subplots(figsize=(14, 14), dpi=180, facecolor="#f4efe7")
    plot_part1_detailed_base(ax, G, "Cheapest Insertion for Leftover Order")
    plot_delivery_points(ax, delivery_data, show_labels=False)
    plot_matrix_route_arrows(ax, delivery_data, base_route, "#2563eb", linewidth=1.7, alpha=0.65)
    plot_matrix_route_arrows(ax, delivery_data, inserted_route, "#16a34a", linewidth=2.5, alpha=0.9)

    order = delivery_data["deliveries"][matrix_index_to_order_idx(inserted)]
    ax.scatter(
        order["lon"],
        order["lat"],
        s=160,
        marker="*",
        color="#ef4444",
        edgecolor="white",
        linewidth=0.8,
        zorder=55,
    )
    ax.text(
        order["lon"],
        order["lat"],
        f"+{best_delta:.1f} min",
        fontsize=9,
        color="#111827",
        fontweight="bold",
        zorder=56,
    )
    save_presentation_figure(fig, "11_cheapest_insertion.png")


