def select_demo_route(solution: dict[str, Any]) -> dict[str, Any] | None:
    candidates = [r for r in solution["schedule"] if len(r["route_stops"]) >= 5]
    if not candidates:
        candidates = solution["schedule"]
    if not candidates:
        return None
    return max(candidates, key=lambda r: len(r["route_stops"]))


def plot_matrix_route_arrows(
    ax: Any,
    delivery_data: dict[str, Any],
    matrix_route: list[int],
    color: str,
    linewidth: float = 2.0,
    alpha: float = 0.9,
    label_steps: bool = False,
) -> None:
    depots = delivery_data["depots"]
    deliveries = delivery_data["deliveries"]

    def coords(matrix_idx: int) -> tuple[float, float]:
        if matrix_idx < N_DEPOTS:
            point = depots[matrix_idx]
        else:
            point = deliveries[matrix_index_to_order_idx(matrix_idx)]
        return float(point["lon"]), float(point["lat"])

    for seq, (src, dst) in enumerate(zip(matrix_route[:-1], matrix_route[1:]), start=1):
        x1, y1 = coords(src)
        x2, y2 = coords(dst)
        ax.annotate(
            "",
            xy=(x2, y2),
            xytext=(x1, y1),
            arrowprops={
                "arrowstyle": "->",
                "color": color,
                "lw": linewidth,
                "alpha": alpha,
                "shrinkA": 5,
                "shrinkB": 5,
            },
            zorder=45,
        )
        if label_steps and dst >= N_DEPOTS:
            ax.text(
                x2,
                y2,
                str(seq),
                fontsize=7,
                color="white",
                ha="center",
                va="center",
                bbox={"boxstyle": "circle,pad=0.2", "facecolor": color, "edgecolor": "white", "linewidth": 0.4},
                zorder=50,
            )


