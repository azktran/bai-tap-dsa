class SegmentTree:
    """Segment tree for fast route-leg cost updates and range sums."""

    def __init__(self, values: list[float]) -> None:
        self.n = len(values)
        size = 1
        while size < max(1, self.n):
            size *= 2
        self.size = size
        self.tree = [0.0] * (2 * size)
        for idx, value in enumerate(values):
            self.tree[size + idx] = float(value)
        for idx in range(size - 1, 0, -1):
            self.tree[idx] = self.tree[idx * 2] + self.tree[idx * 2 + 1]

    def update(self, index: int, value: float) -> None:
        pos = self.size + index
        self.tree[pos] = float(value)
        pos //= 2
        while pos:
            self.tree[pos] = self.tree[pos * 2] + self.tree[pos * 2 + 1]
            pos //= 2

    def range_sum(self, left: int, right: int) -> float:
        left += self.size
        right += self.size
        total = 0.0
        while left < right:
            if left % 2:
                total += self.tree[left]
                left += 1
            if right % 2:
                right -= 1
                total += self.tree[right]
            left //= 2
            right //= 2
        return total


def matrix_to_coo(matrix: np.ndarray, finite_mask: np.ndarray) -> tuple[np.ndarray, np.ndarray, np.ndarray]:
    rows, cols = np.nonzero(finite_mask)
    values = matrix[rows, cols].astype(np.float32)
    return rows.astype(np.int32), cols.astype(np.int32), values


def evaluate_sparse_matrix_upgrade() -> dict[str, Any]:
    print("\n[DSA 5/8] Dense matrix vs sparse COO benchmark...")
    time_matrix = np.load(OUTPUT_DIR / "time_matrix.npy")
    dist_matrix = np.load(OUTPUT_DIR / "dist_matrix.npy")
    finite_mask = (time_matrix < UNREACHABLE) & np.isfinite(time_matrix)

    start = time.perf_counter()
    time_rows, time_cols, time_values = matrix_to_coo(time_matrix, finite_mask)
    dist_rows, dist_cols, dist_values = matrix_to_coo(dist_matrix, finite_mask)
    build_time = time.perf_counter() - start

    ensure_dsa_output_dir()
    sparse_path = DSA_OUTPUT_DIR / "05_sparse_matrices_coo.npz"
    np.savez_compressed(
        sparse_path,
        time_rows=time_rows,
        time_cols=time_cols,
        time_values=time_values,
        dist_rows=dist_rows,
        dist_cols=dist_cols,
        dist_values=dist_values,
        shape=np.asarray(time_matrix.shape, dtype=np.int32),
    )

    dense_bytes = int(time_matrix.nbytes + dist_matrix.nbytes)
    sparse_bytes = int(
        time_rows.nbytes
        + time_cols.nbytes
        + time_values.nbytes
        + dist_rows.nbytes
        + dist_cols.nbytes
        + dist_values.nbytes
    )
    density = len(time_values) / max(time_matrix.size, 1)
    metrics = {
        "upgrade": "Dense Matrix -> Sparse COO Matrix",
        "part": "Part 2 & 3",
        "matrix_shape": list(time_matrix.shape),
        "dense_storage_bytes": dense_bytes,
        "sparse_coo_storage_bytes": sparse_bytes,
        "reachable_entries": int(len(time_values)),
        "total_entries": int(time_matrix.size),
        "density_pct": round(density * 100, 4),
        "storage_reduction_x": round(dense_bytes / max(sparse_bytes, 1), 2),
        "build_time_sec": round(build_time, 6),
        "output_files": [str(sparse_path)],
    }
    save_dsa_json("05_sparse_matrix_metrics.json", metrics)
    save_dsa_csv("05_sparse_matrix_metrics.csv", [metrics])
    print(f"  Dense bytes: {dense_bytes:,} | sparse bytes: {sparse_bytes:,}")
    return metrics


def route_leg_costs(path: list[int], time_matrix: np.ndarray) -> list[float]:
    return [float(time_matrix[src, dst]) for src, dst in zip(path[:-1], path[1:])]


def evaluate_segment_tree_upgrade(solution: dict[str, Any]) -> dict[str, Any]:
    print("\n[DSA 6/8] Python list recompute vs Segment Tree benchmark...")
    time_matrix = np.load(OUTPUT_DIR / "time_matrix.npy")
    routes = [route for route in solution["schedule"] if len(route["route_stops"]) >= 3]
    if not routes:
        metrics = {"upgrade": "Python List -> Segment Tree", "part": "Part 4", "note": "No route with enough stops."}
        save_dsa_json("06_segment_tree_metrics.json", metrics)
        return metrics

    route = max(routes, key=lambda item: len(item["route_stops"]))
    leg_costs = route_leg_costs(route["route_stops"], time_matrix)
    rng = random.Random(RANDOM_SEED)
    updates = [
        (rng.randrange(len(leg_costs)), rng.uniform(0.5, max(max(leg_costs), 1.0) * 1.5))
        for _ in range(DSA_SEGMENT_TREE_OPS)
    ]

    list_costs = leg_costs[:]
    start = time.perf_counter()
    list_checksum = 0.0
    for index, new_value in updates:
        list_costs[index] = new_value
        list_checksum += sum(list_costs)
    list_time = time.perf_counter() - start

    tree = SegmentTree(leg_costs)
    start = time.perf_counter()
    tree_checksum = 0.0
    current = leg_costs[:]
    for index, new_value in updates:
        current[index] = new_value
        tree.update(index, current[index])
        tree_checksum += tree.range_sum(0, len(current))
    tree_time = time.perf_counter() - start

    metrics = {
        "upgrade": "Python List route cost recompute -> Segment Tree",
        "part": "Part 4",
        "route_shipper_id": route["shipper_id"],
        "route_leg_count": len(leg_costs),
        "benchmark_operations": len(updates),
        "list_recompute_time_sec": round(list_time, 6),
        "segment_tree_update_query_time_sec": round(tree_time, 6),
        "speedup_x": round(list_time / max(tree_time, 1e-9), 2),
        "checksum_match": abs(list_checksum - tree_checksum) <= 1e-6,
        "note": "This benchmarks repeated route-cost updates; actual Python list insertion still shifts elements.",
    }
    save_dsa_json("06_segment_tree_metrics.json", metrics)
    save_dsa_csv("06_segment_tree_metrics.csv", [metrics])
    print(f"  Segment tree speedup: {metrics['speedup_x']}x")
    return metrics


def route_distance_for_stops(depot_idx: int, stops: list[int], matrix: np.ndarray) -> float:
    return route_travel_time([depot_idx] + stops + [depot_idx], matrix)


def tabu_search_route(
    depot_idx: int,
    initial_stops: list[int],
    time_matrix: np.ndarray,
    iterations: int = DSA_TABU_ITERATIONS,
    tabu_tenure: int = 12,
) -> tuple[list[int], float, list[dict[str, Any]]]:
    if len(initial_stops) < 4:
        cost = route_distance_for_stops(depot_idx, initial_stops, time_matrix)
        return initial_stops[:], cost, []

    current = initial_stops[:]
    best = current[:]
    current_cost = route_distance_for_stops(depot_idx, current, time_matrix)
    best_cost = current_cost
    tabu: dict[tuple[int, int], int] = {}
    history = []

    for iteration in range(iterations):
        candidate = None
        candidate_move = None
        candidate_cost = float("inf")

        for i in range(len(current) - 1):
            for j in range(i + 1, len(current)):
                move = (min(current[i], current[j]), max(current[i], current[j]))
                trial = current[:]
                trial[i], trial[j] = trial[j], trial[i]
                cost = route_distance_for_stops(depot_idx, trial, time_matrix)
                aspiration = cost < best_cost
                if tabu.get(move, -1) > iteration and not aspiration:
                    continue
                if cost < candidate_cost:
                    candidate = trial
                    candidate_move = move
                    candidate_cost = cost

        if candidate is None or candidate_move is None:
            break

        current = candidate
        current_cost = candidate_cost
        tabu[candidate_move] = iteration + tabu_tenure
        if current_cost < best_cost:
            best = current[:]
            best_cost = current_cost

        history.append(
            {
                "iteration": iteration,
                "current_cost_min": round(float(current_cost), 4),
                "best_cost_min": round(float(best_cost), 4),
            }
        )

    return best, best_cost, history


def evaluate_tabu_upgrade(solution: dict[str, Any]) -> dict[str, Any]:
    print("\n[DSA 7/8] Greedy/2-opt vs Tabu Search benchmark...")
    time_matrix = np.load(OUTPUT_DIR / "time_matrix.npy")
    routes = [route for route in solution["schedule"] if len(route["route_stops"]) >= 6]
    if not routes:
        metrics = {"upgrade": "Greedy/2-opt -> Tabu Search", "part": "Part 4", "note": "No long enough route."}
        save_dsa_json("07_tabu_search_metrics.json", metrics)
        return metrics

    route = max(routes, key=lambda item: len(item["route_stops"]))
    depot_idx = int(route["depot_idx"])
    initial_stops = [idx for idx in route["route_stops"][1:-1] if idx >= N_DEPOTS]
    baseline_cost = route_distance_for_stops(depot_idx, initial_stops, time_matrix)

    start = time.perf_counter()
    best_stops, best_cost, history = tabu_search_route(depot_idx, initial_stops, time_matrix)
    tabu_time = time.perf_counter() - start

    history_path = save_dsa_csv("07_tabu_search_iterations.csv", history)
    metrics = {
        "upgrade": "Greedy + 2-opt -> Tabu Search meta-heuristic",
        "part": "Part 4",
        "route_shipper_id": route["shipper_id"],
        "stop_count": len(initial_stops),
        "iterations": DSA_TABU_ITERATIONS,
        "baseline_route_cost_min": round(float(baseline_cost), 4),
        "tabu_best_cost_min": round(float(best_cost), 4),
        "improvement_min": round(float(baseline_cost - best_cost), 4),
        "improvement_pct": round((baseline_cost - best_cost) / max(baseline_cost, 1e-9) * 100, 3),
        "runtime_sec": round(tabu_time, 6),
        "best_route_stops": [int(stop) for stop in best_stops],
        "output_files": [str(history_path)],
    }
    save_dsa_json("07_tabu_search_metrics.json", metrics)
    save_dsa_csv("07_tabu_search_metrics.csv", [metrics])
    print(f"  Tabu improvement: {metrics['improvement_pct']}%")
    return metrics


def build_simulation_events_from_solution(
    solution: dict[str, Any],
    delivery_data: dict[str, Any],
    time_matrix: np.ndarray,
) -> list[dict[str, Any]]:
    deliveries = delivery_data["deliveries"]
    events = []
    sequence = 0
    for route in solution["schedule"]:
        shipper_id = route["shipper_id"]
        path = route["route_stops"]
        current_time = parse_departure_minutes(route["departure"])
        events.append(
            {
                "time_min": round(current_time, 1),
                "sequence": sequence,
                "clock": minutes_to_clock(current_time),
                "type": "DEPART",
                "shipper_id": shipper_id,
                "target": route["depot_name"],
            }
        )
        sequence += 1
        for src, dst in zip(path[:-1], path[1:]):
            current_time += float(time_matrix[src, dst])
            if dst >= N_DEPOTS:
                order_idx = matrix_index_to_order_idx(dst)
                events.append(
                    {
                        "time_min": round(current_time, 1),
                        "sequence": sequence,
                        "clock": minutes_to_clock(current_time),
                        "type": "ARRIVE_ORDER",
                        "shipper_id": shipper_id,
                        "target": deliveries[order_idx]["order_id"],
                    }
                )
                sequence += 1
                current_time += SERVICE_TIME_MIN
                events.append(
                    {
                        "time_min": round(current_time, 1),
                        "sequence": sequence,
                        "clock": minutes_to_clock(current_time),
                        "type": "DELIVERED",
                        "shipper_id": shipper_id,
                        "target": deliveries[order_idx]["order_id"],
                    }
                )
                sequence += 1
            else:
                events.append(
                    {
                        "time_min": round(current_time, 1),
                        "sequence": sequence,
                        "clock": minutes_to_clock(current_time),
                        "type": "RETURN_DEPOT",
                        "shipper_id": shipper_id,
                        "target": route["depot_name"],
                    }
                )
                sequence += 1
    return events


def evaluate_minheap_upgrade(solution: dict[str, Any]) -> dict[str, Any]:
    print("\n[DSA 8/8] Timsort event list vs Min-Heap event queue benchmark...")
    delivery_data = load_json(OUTPUT_DIR / "delivery_nodes.json")
    time_matrix = np.load(OUTPUT_DIR / "time_matrix.npy")
    events = build_simulation_events_from_solution(solution, delivery_data, time_matrix)
    rng = random.Random(RANDOM_SEED)
    dynamic_events = []
    for idx in range(DSA_HEAP_DYNAMIC_EVENTS):
        base = rng.choice(events)
        dynamic_events.append(
            {
                **base,
                "time_min": round(float(base["time_min"]) + rng.uniform(-5.0, 15.0), 1),
                "sequence": len(events) + idx,
                "type": "DYNAMIC_UPDATE",
            }
        )

    start = time.perf_counter()
    sorted_events = sorted(events + dynamic_events, key=lambda item: (item["time_min"], item["sequence"]))
    sort_time = time.perf_counter() - start

    start = time.perf_counter()
    heap = []
    for event in events:
        heapq.heappush(heap, (event["time_min"], event["sequence"], event))
    for event in dynamic_events:
        heapq.heappush(heap, (event["time_min"], event["sequence"], event))
    heap_events = [heapq.heappop(heap)[2] for _ in range(len(heap))]
    heap_time = time.perf_counter() - start

    sample_path = save_dsa_csv(
        "08_minheap_event_order_sample.csv",
        [
            {
                "rank": idx,
                "time_min": event["time_min"],
                "clock": event["clock"],
                "type": event["type"],
                "shipper_id": event["shipper_id"],
                "target": event["target"],
            }
            for idx, event in enumerate(heap_events[:80])
        ],
    )
    metrics = {
        "upgrade": "Timsort event list -> Min-Heap priority queue",
        "part": "Part 5",
        "base_event_count": len(events),
        "dynamic_event_count": len(dynamic_events),
        "total_event_count": len(sorted_events),
        "timsort_batch_time_sec": round(sort_time, 6),
        "minheap_push_pop_time_sec": round(heap_time, 6),
        "speedup_x": round(sort_time / max(heap_time, 1e-9), 2),
        "same_event_order": [
            (event["time_min"], event["sequence"]) for event in sorted_events
        ]
        == [
            (event["time_min"], event["sequence"]) for event in heap_events
        ],
        "note": "Heap supports online event insertion in O(log n); sorted() is still strong for one-shot batch sorting.",
        "output_files": [str(sample_path)],
    }
    save_dsa_json("08_minheap_metrics.json", metrics)
    save_dsa_csv("08_minheap_metrics.csv", [metrics])
    print(f"  Heap same order: {metrics['same_event_order']} | speedup: {metrics['speedup_x']}x")
    return metrics


