def parse_departure_minutes(value: str) -> float:
    hour, minute = value.split(":")
    return (int(hour) - WORKING_START_HOUR) * 60 + int(minute)


def matrix_point_latlon(delivery_data: dict[str, Any], matrix_idx: int) -> tuple[float, float]:
    if matrix_idx < N_DEPOTS:
        point = delivery_data["depots"][matrix_idx]
    else:
        point = delivery_data["deliveries"][matrix_index_to_order_idx(matrix_idx)]
    return float(point["lat"]), float(point["lon"])


def matrix_leg_animation_path(
    G: nx.MultiDiGraph | None,
    delivery_data: dict[str, Any],
    src_idx: int,
    dst_idx: int,
) -> list[list[float]]:
    if G is not None:
        graph_route = matrix_route_to_graph_route(G, [src_idx, dst_idx])
        latlon = route_latlon_path(G, graph_route) if graph_route else []
        if len(latlon) >= 2:
            return [[float(lat), float(lon)] for lat, lon in latlon]

    src = matrix_point_latlon(delivery_data, src_idx)
    dst = matrix_point_latlon(delivery_data, dst_idx)
    return [[src[0], src[1]], [dst[0], dst[1]]]


def build_delivery_animation_segments(
    G: nx.MultiDiGraph | None,
    solution: dict[str, Any],
    delivery_data: dict[str, Any],
    time_matrix: np.ndarray,
) -> list[dict[str, Any]]:
    segments = []
    sequence = 0

    for route in solution["schedule"]:
        shipper_id = int(route["shipper_id"])
        path = [int(idx) for idx in route["route_stops"]]
        current_time = parse_departure_minutes(route["departure"])

        for src_idx, dst_idx in zip(path[:-1], path[1:]):
            travel = max(float(time_matrix[src_idx, dst_idx]), 0.01)
            start_time = current_time
            end_time = current_time + travel

            if dst_idx >= N_DEPOTS:
                target = delivery_data["deliveries"][matrix_index_to_order_idx(dst_idx)]["order_id"]
                status = f"Driving to {target}"
            else:
                target = route["depot_name"]
                status = "Returning to depot"

            segments.append(
                {
                    "sequence": sequence,
                    "shipper_id": shipper_id,
                    "start_min": round(start_time, 3),
                    "end_min": round(end_time, 3),
                    "type": "DRIVE",
                    "label": status,
                    "path": matrix_leg_animation_path(G, delivery_data, src_idx, dst_idx),
                }
            )
            sequence += 1
            current_time = end_time

            if dst_idx >= N_DEPOTS:
                lat, lon = matrix_point_latlon(delivery_data, dst_idx)
                order_id = delivery_data["deliveries"][matrix_index_to_order_idx(dst_idx)]["order_id"]
                segments.append(
                    {
                        "sequence": sequence,
                        "shipper_id": shipper_id,
                        "start_min": round(current_time, 3),
                        "end_min": round(current_time + SERVICE_TIME_MIN, 3),
                        "type": "SERVICE",
                        "label": f"Delivering {order_id}",
                        "path": [[lat, lon], [lat, lon]],
                    }
                )
                sequence += 1
                current_time += SERVICE_TIME_MIN

    return segments


