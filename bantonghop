def visualize_cleaning_graph(G: nx.MultiDiGraph) -> None:
    print("\n[SLIDES] 01 graph cleaning...")
    raw = build_raw_graph_for_visual()
    if raw is None:
        return

    cleaned_edges = set((str(u), str(v), str(k)) for u, v, k in G.edges(keys=True))
    raw_edges = ox.graph_to_gdfs(raw, nodes=False, edges=True).reset_index()
    clean_edges = ox.graph_to_gdfs(G, nodes=False, edges=True).reset_index()

    raw_edges["_edge_id"] = raw_edges.apply(
        lambda row: (str(row["u"]), str(row["v"]), str(row["key"])),
        axis=1,
    )
    removed_edges = raw_edges[~raw_edges["_edge_id"].isin(cleaned_edges)]

    fig, axes = plt.subplots(1, 2, figsize=(18, 9), dpi=180, facecolor="#f4efe7")
    for ax in axes:
        ax.set_facecolor("#f4efe7")
        ax.set_axis_off()

    raw_edges.plot(ax=axes[0], color="#9ca3af", linewidth=0.45, alpha=0.55)
    if len(removed_edges) > 0:
        removed_edges.plot(ax=axes[0], color="#ef4444", linewidth=0.85, alpha=0.9)
    axes[0].set_title(
        f"Raw OSM graph\n{raw.number_of_nodes():,} nodes | {raw.number_of_edges():,} edges",
        fontsize=13,
        fontweight="bold",
        loc="left",
    )

    clean_edges.plot(ax=axes[1], color="#111827", linewidth=0.45, alpha=0.75)
    axes[1].set_title(
        f"Cleaned logistics graph\n{G.number_of_nodes():,} nodes | {G.number_of_edges():,} edges",
        fontsize=13,
        fontweight="bold",
        loc="left",
    )
    save_presentation_figure(fig, "01_graph_cleaning_raw_vs_cleaned.png")


